{
  "compilerOptions": {
    "rootDir": "./",
    "outDir": "./dist",
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "esnext",
    "sourceMap": true,
    "declaration": true,
    "noEmit": true,
    "emitDeclarationOnly": true,
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true, 
    "types": ["vitest/globals"],
  },
  "include": ["src/**/*", "dev/**/*", "global.d.ts"],
  "exclude": [
    "src/**/*.test.ts", 
    "src/**/*.test.tsx", 
    "src/**/*.mock.ts", 
    "src/**/*.mock.tsx"
  ],
}